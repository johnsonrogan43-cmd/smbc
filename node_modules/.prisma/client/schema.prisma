generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())
  sessions     Session[]
  auditLogs    AuditLog[]
}

model User {
  id            String         @id @default(cuid())
  fullName      String
  email         String         @unique
  phone         String
  passwordHash  String?
  status        String         @default("ACTIVE")
  accessCode    String?        @unique
  createdAt     DateTime       @default(now())
  accounts      Account[]
  transactions  Transaction[]
  transfers     Transfer[]
  notifications Notification[]
  sessions      Session[]
}

model Account {
  id            String        @id @default(cuid())
  userId        String
  name          String
  type          String
  currency      String        @default("JPY")
  accountNumber String        @unique
  balance       Int           @default(0)
  status        String        @default("ACTIVE")
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id])
  transactions  Transaction[]
  transfers     Transfer[]
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  type        String
  description String
  senderName  String?
  amount      Int
  currency    String   @default("JPY")
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  account     Account  @relation(fields: [accountId], references: [id])
}

model Transfer {
  id                String             @id @default(cuid())
  userId            String
  accountId         String
  recipientName     String
  bankName          String
  recipientAccount  String
  amount            Int
  fee               Int                @default(0)
  currency          String             @default("JPY")
  message           String?
  status            String             @default("PROCESSING")
  currentStage      Int                @default(1)
  reference         String             @unique
  createdAt         DateTime           @default(now())
  completedAt       DateTime?
  user              User               @relation(fields: [userId], references: [id])
  account           Account            @relation(fields: [accountId], references: [id])
  verificationCodes VerificationCode[]
}

model VerificationCode {
  id          String    @id @default(cuid())
  transferId  String
  stage       Int
  codeHash    String
  codePreview String
  expiresAt   DateTime
  usedAt      DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  transfer    Transfer  @relation(fields: [transferId], references: [id])

  @@unique([transferId, stage])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model EmailNotification {
  id         String   @id @default(cuid())
  userId     String
  transferId String?
  subject    String
  body       String
  sentAt     DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
  admin      Admin?   @relation(fields: [adminId], references: [id])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String?
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}
