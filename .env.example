# ═══════════════════════════════════════════════════════════════════════════
# SMBC — Environment Variables Template
#
# LOCAL DEV:  Copy this file to `.env` and fill in values.
# VERCEL:     Set all of these in Vercel Dashboard → Project → Settings
#             → Environment Variables. Then Redeploy (Deployments →
#             your latest deploy → "Redeploy" checkbox "Build without cache").
# ═══════════════════════════════════════════════════════════════════════════

# ── MongoDB (REQUIRED) ───────────────────────────────────────────────────
# Create a free cluster at https://mongodb.com/atlas.
#  - Network Access: ADD "0.0.0.0/0" (includes all IPs) — Vercel serverless
#    functions don't have a static IP, so whitelisting specific IPs won't work.
#  - Database Access: Create a DB user with "readWriteAnyDatabase" role.
#  - Copy the "Connect → Connect your application" URI exactly below.
MONGO_URI="mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?appName=<app_name>&retryWrites=true&w=majority"
MONGO_DB="smbc"

# ── JWT Signing Secret (REQUIRED for production) ─────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be identical between local .env and Vercel env — otherwise every
# request gets 401 "Session expired" because tokens were signed with a
# different key.
JWT_SECRET="generate-with-node-crypto.randomBytes(64).toString('hex')"

# ── Backend port (local only; ignored on Vercel) ─────────────────────────
PORT=4000

# ═══════════════════════════════════════════════════════════════════════════
# Frontend (Vite)
# ═══════════════════════════════════════════════════════════════════════════
# Leave unset on Vercel — the rewrite rule in vercel.json routes /api/* to
# the same-origin serverless function at /api, which enables secure
# same-site cookies with no CORS complexity.
#
# Set ONLY if you host the backend on a DIFFERENT domain, e.g.:
#   VITE_API_URL="https://api.yourdomain.com/api"
# VITE_API_URL=

# ═══════════════════════════════════════════════════════════════════════════
# Production flags (set on Vercel)
# ═══════════════════════════════════════════════════════════════════════════
# Setting NODE_ENV=production switches cookies to SameSite=None + Secure.
# This is REQUIRED when the API is served from a different origin than the
# page, or when cross-site authentication must work. Vercel does NOT set
# this automatically; add it yourself.
NODE_ENV=production

# Override cross-site cookie mode explicitly (optional). Equivalent effect
# to NODE_ENV=production; both trigger SameSite=None; Secure.
# COOKIE_CROSS_SITE=true